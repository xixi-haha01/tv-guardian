<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_lock"
    android:gravity="center">

    <!-- 警告图标 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️"
        android:textSize="180sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/lock_title"
        android:textColor="#FFFF5252"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lock_reason"
        android:textColor="#FFBDBDBD"
        android:textSize="24sp" />

    <!-- 倒计时 -->
    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:textColor="#FFFFD740"
        android:textSize="160sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/pb_lock"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="800dp"
        android:layout_height="8dp"
        android:layout_marginTop="32dp"
        android:progressTint="#FFFFD740"
        android:max="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/lock_hint"
        android:textColor="#FF757575"
        android:textSize="20sp"
        android:gravity="center" />

</LinearLayout>
